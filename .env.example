# Server locale / VPS
HOST=127.0.0.1
PORT=8765

# Token lungo e casuale richiesto per leggere o scrivere /api/state.
# Esempio di generazione: openssl rand -hex 32
BALI_SYNC_TOKEN=replace-with-a-long-random-token

# OAuth Web Client pubblico per login Google/Gmail.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# PostgreSQL persistente (Neon, Supabase o altro provider compatibile).
# Trattare questa variabile come segreto nel provider di hosting.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
